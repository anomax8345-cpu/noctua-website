# ---------------------------------------------------------------------------
# Tennis Dashboard — environment configuration
# Copy this file to ".env" and fill in your values. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# REQUIRED for live tennis data. Default provider: API-Tennis (api-tennis.com).
# NOTE: API-Sports (the football provider) does NOT cover tennis, so this is a
# separate key. Read only on the server; never exposed to the frontend.
API_TENNIS_KEY=

# API-Tennis base host (method-based REST API).
API_TENNIS_HOST=api.api-tennis.com

# Flask settings
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=0

# Analysis window & display
LOOKAHEAD_HOURS=48
TIMEZONE=Europe/Zurich

# Which tours to analyse. Either ALL, or a comma-separated list of tour names
# exactly as in config.TOUR_CATALOG, e.g.  ENABLED_TOURS=ATP,WTA,Grand Slam
ENABLED_TOURS=ALL

# Signal thresholds (highlighting only — never "sure bet" claims)
MIN_EDGE_PP=3.0
MIN_CONFIDENCE=60
MIN_LIQUIDITY_USD=500

# Auto-refresh intervals (seconds)
REFRESH_MARKETS_SECONDS=300
REFRESH_TENNIS_SECONDS=1800

# Cache TTL (seconds)
CACHE_TTL_FIXTURES=900
CACHE_TTL_PLAYER_FORM=3600
CACHE_TTL_RANKINGS=43200
CACHE_TTL_MARKETS=120
