# ---------------------------------------------------------------------------
# Football Dashboard — environment configuration
# Copy this file to ".env" and fill in your values. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# REQUIRED for live football data. Get a key at https://www.api-football.com/
# (RapidAPI keys also work — see API_FOOTBALL_HOST below).
# The key is read ONLY on the server. It is never exposed to the frontend.
API_FOOTBALL_KEY=

# API-Football host.
#  - Direct (api-sports.io):   v3.football.api-sports.io
#  - Via RapidAPI:             api-football-v1.p.rapidapi.com
API_FOOTBALL_HOST=v3.football.api-sports.io

# Flask settings
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=0

# Analysis window & display
LOOKAHEAD_HOURS=48
TIMEZONE=Europe/Zurich

# Which leagues to analyse. Either the literal word ALL, or a comma-separated
# list of league names exactly as they appear in config.LEAGUE_CATALOG,
# e.g.  ENABLED_LEAGUES=Bundesliga,Premier League,Champions League
ENABLED_LEAGUES=ALL

# Signal thresholds (used only for highlighting, never for "sure bet" claims)
MIN_EDGE_PP=3.0
MIN_CONFIDENCE=60
MIN_LIQUIDITY_USD=500

# Auto-refresh intervals (seconds) used by the frontend
REFRESH_MARKETS_SECONDS=300
REFRESH_FOOTBALL_SECONDS=1800

# Cache time-to-live (seconds)
CACHE_TTL_FIXTURES=900
CACHE_TTL_TEAM_FORM=3600
CACHE_TTL_STANDINGS=21600
CACHE_TTL_MARKETS=120
